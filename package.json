{
  "name": "ecommerce",
  "version": "1.0.0",
  "description": "ShopEase — full-stack e-commerce built entirely with Next.js (App Router API routes) + MongoDB. No separate backend.",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix my-next-app install",
    "dev": "(mongosh --quiet --eval 'db.runCommand({ping:1})' > /dev/null 2>&1 || mongod --config /opt/homebrew/etc/mongod.conf --fork) && npm --prefix my-next-app run dev",
    "dev:app": "npm --prefix my-next-app run dev",
    "seed": "npm --prefix my-next-app run seed",
    "build": "npm --prefix my-next-app run build"
  },
  "license": "ISC"
}
